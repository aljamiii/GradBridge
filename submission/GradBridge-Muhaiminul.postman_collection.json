{
  "info": {
    "name": "GradBridge — Muhaiminul (CSE471 Assignment 03)",
    "description": "Feature A: Mentor Matcher & Booking. Feature B: Community Forum & Insights. Server runs on port 1384 (last 4 digits of student ID). Run '0. Login' first — it auto-saves the JWT into the {{token}} collection variable; the mentor/post/booking id requests auto-capture ids too, so you can Send top-to-bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:1384" },
    { "key": "token", "value": "" },
    { "key": "mentorId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "conversationId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Login (get token)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"muhaiminul@test.com\",\n  \"password\": \"demo12345\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.token) { pm.collectionVariables.set('token', j.token); console.log('token saved'); }",
              "pm.test('logged in', () => pm.expect(j.success).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Feature A — Mentor Booking & Real-Time Chat",
      "item": [
        {
          "name": "Setup — List mentors (grabs a mentor id, not a documented API)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/mentors", "host": ["{{baseUrl}}"], "path": ["api", "mentors"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.mentors && j.mentors.length) { pm.collectionVariables.set('mentorId', j.mentors[0].id); console.log('mentorId saved:', j.mentors[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "A1. Create booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mentorId\": \"{{mentorId}}\",\n  \"start\": \"2026-08-01T10:00:00Z\",\n  \"durationMins\": 30,\n  \"topic\": \"PhD supervision guidance\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.booking && j.booking._id) { pm.collectionVariables.set('bookingId', j.booking._id); console.log('bookingId saved:', j.booking._id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "A2. List my bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "A3. Update booking status (student cancels)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"cancelled\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "status"]
            }
          }
        },
        {
          "name": "A4. Start a conversation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{mentorId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/chat/start", "host": ["{{baseUrl}}"], "path": ["api", "chat", "start"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.conversationId) { pm.collectionVariables.set('conversationId', j.conversationId); console.log('conversationId saved:', j.conversationId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "A5. Inbox — list my conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/chat", "host": ["{{baseUrl}}"], "path": ["api", "chat"] }
          }
        },
        {
          "name": "A6. Message history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chat/{{conversationId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "{{conversationId}}", "messages"]
            }
          }
        },
        {
          "name": "A7. Unread count",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/chat/unread-count", "host": ["{{baseUrl}}"], "path": ["api", "chat", "unread-count"] }
          }
        }
      ]
    },
    {
      "name": "Feature B — Bangladeshi Abroad Network Map",
      "item": [
        {
          "name": "B1. Opt in to the map (update profile + geocode)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentProfile\": {\n    \"abroad\": {\n      \"optIn\": true,\n      \"city\": \"Toronto\",\n      \"country\": \"Canada\",\n      \"university\": \"University of Toronto\",\n      \"degreeLevel\": \"Masters\",\n      \"subject\": \"Computer Science\"\n    }\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"] }
          }
        },
        {
          "name": "B2. Get network map pins",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/network-map", "host": ["{{baseUrl}}"], "path": ["api", "users", "network-map"] }
          }
        }
      ]
    }
  ]
}
